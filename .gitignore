# 1. 忽略当前目录下的所有文件和文件夹
/*

# 2. 只追踪配置文件、coze文件、desktop-ui源代码(桌面版界面)、apk移动端
!/openclaw.json
!/scripts
!/.coze
!/.gitignore
!/desktop-ui
!/apk
!/backend
!/server
!/deploy
!/docs
!/shared
!/.github
!/desktop
!/package.json
!/README.md

# 3. desktop-ui目录下的忽略项（桌面版界面源码，Next.js 静态导出）
desktop-ui/.next
desktop-ui/.next_bak_*
desktop-ui/node_modules
# 敏感配置
desktop-ui/.env
# 本地开发配置（可提交）
desktop-ui/.env.local
# 生产环境配置（可提交）
desktop-ui/.env.production
desktop-ui/.turbo
desktop-ui/dist
desktop-ui/out
desktop-ui/.DS_Store
desktop-ui/*.log
desktop-ui/.pnpm-debug.log*
# TypeScript 增量编译缓存
desktop-ui/tsconfig.tsbuildinfo

# 4. apk目录下的忽略项
apk/.next
apk/node_modules
# 敏感配置
apk/.env
# 本地开发配置（可提交）
apk/.env.local
# 生产环境配置（可提交）
apk/.env.production
apk/out
apk/dist
apk/.DS_Store
apk/*.log

# 5. backend目录下的忽略项
backend/node_modules
backend/.env*
backend/dist
backend/logs

# 5.1 scripts 下的测试临时产物（自动更新签名测试等）
scripts/__pycache__/
scripts/desktop-run*.log
scripts/deploy-run*.log
scripts/run*.log
scripts/sigtest.*
scripts/decoded-sig.txt
scripts/tmp-*.exe
scripts/tmp-*.exe.sig
scripts/commit-message.txt

# 6. shared目录下的忽略项
shared/node_modules
shared/.env*
shared/dist

# 7. server目录下的忽略项
server/node_modules
server/.env
server/.env.local
server/.env.production
server/.env.test
server/dist
server/logs
server/.pnpm-debug.log*

# 8. desktop目录下的忽略项（Tauri 桌面版）
desktop/node_modules
# desktop-ui/out 的复制产物，构建时重新生成
desktop/frontend
# 本地构建产物（latest.json 等）
desktop/dist
# Rust 编译产物
desktop/src-tauri/target
# tauri build 自动生成
desktop/src-tauri/gen/schemas
# Tauri 应用建议提交，这里暂不追踪
desktop/src-tauri/Cargo.lock
desktop/*.log
# 临时审计/截图产物
scripts/tmp_*.json
scripts/tmp_*.js
scripts/douyin-login-test.png
# 审计结果 JSON（不提交，仅本地分析用）
server/server-audit-*.json
desktop-ui/desktop-ui-audit*.json

# 9. 服务器 downloads 目录（CI 上传的桌面安装包与签名，
#    避免服务器上 git stash push -u 误处理安装包文件）
downloads/
deploy/downloads/
