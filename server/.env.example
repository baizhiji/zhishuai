# 智枢AI Server 端环境变量
# 复制为 .env 并填入真实值。严禁将 .env 提交到 Git。

NODE_ENV=development
PORT=3001
# 后端对外访问地址(供 Web/APK 端使用)
API_BASE_URL=http://localhost:3001
# Web 前端地址(用于生成分享链接/回调)
WEB_URL=http://localhost:3000

# ─── 数据库连接 (TDSQL-C MySQL) ───────────────
# 格式: mysql://user:password@host:3306/dbname
DATABASE_URL=mysql://user:password@host:3306/zhishuai

# ─── 安全密钥 (生产环境必须更换为强随机值) ───────
# JWT 签名密钥，服务启动必需
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
# 历史 JWT 密钥(用于验证旧密码哈希，迁移完成后可移除)
LEGACY_JWT_SECRET=
# 用户API Key 加密密钥(32字节，用于 AES-256-GCM 加密，需与 .env 一致)
ENCRYPTION_KEY=
# 旧版加密密钥别名(部分代码引用，保持一致即可)
API_KEY_ENCRYPTION_KEY=

# ─── CORS 允许的前端域名(逗号分隔) ─────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── AI 模型 API 密钥 ─────────────────────────
# 注意：系统不使用任何兜底 API Key，客户必须自行在「API Key 管理」页面
# 配置自己的腾讯云 TokenHub / 阿里云百炼 / 火山方舟 Key，否则 AI 功能不可用。
# 以下变量仅保留用于兼容旧配置，若存在请删除（可运行 scripts/fix_server_env.py 清理）。
# ALIYUN_DASHSCOPE_API_KEY=
# DASHSCOPE_API_KEY=
# VOLCENGINE_API_KEY=
# ARK_API_KEY=
# TENCENT_API_KEY=
# TENCENT_TOKENHUB_API_KEY=

# ─── 短信服务(腾讯云 SMS，当前仅统计用途) ──────
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
