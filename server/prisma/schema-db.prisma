  User            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([humanId])
  @@index([templateId])
  @@index([userId, status])
}

model VideoTemplate {
  id         String      @id
  name       String
  thumbnail  String?
  duration   Int         @default(30)
  style      String
  scenes     Int         @default(1)
  usageCount Int         @default(0)
  config     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime
  VideoTask  VideoTask[]

  @@index([style])
}

model VoiceClone {
  id          String   @id
  userId      String
  name        String
  gender      String   @default("female")
  description String?
  audioUrl    String?
  language    String   @default("zh-CN")
  status      String   @default("ready")
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}
