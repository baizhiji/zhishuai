generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AIContentFeedback {
  id          String   @id
  userId      String
  contentId   String?
  contentType String
  content     String
  adopted     Boolean  @default(false)
  edited      Boolean  @default(false)
  rating      Int?
  edits       String?
  platform    String?
  createdAt   DateTime @default(now())

  @@index([contentType])
  @@index([userId, createdAt])
}

model AIExample {
  id         String   @id
  type       String
  platform   String?
  content    String
  quality    Float    @default(7)
  tags       String?
  metadata   Json?
  source     String?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([quality])
  @@index([type, platform])
}

model AIUsageStats {
  id           String   @id
  userId       String
  agentId      String?
  feature      String
  model        String
  tokens       Int      @default(0)
  cost         Decimal  @default(0.0000) @db.Decimal(10, 4)
  successCount Int      @default(0)
  failCount    Int      @default(0)
  period       String   @default("daily")
  periodStart  DateTime
  createdAt    DateTime @default(now())

  @@unique([userId, feature, model, periodStart])
  @@index([userId, periodStart])
}

model AcquisitionAutomation {
  id             String    @id
  userId         String
  name           String
  platform       String
  status         String    @default("draft")
  targetLeads    Int       @default(100)
  currentLeads   Int       @default(0)
  productInfo    String?
  targetAudience String?
  strategy       Json?
  schedule       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AcquisitionData {
  id            String    @id
  userId        String
  source        String
  sourceType    String
  name          String?
  phone         String?
  email         String?
  wechat        String?
  company       String?
  position      String?
  address       String?
  latitude      Float?
  longitude     Float?
  business      String?
  employeeCount String?
  roomId        String?
  roomName      String?
  platform      String?
  intentScore   Int?
  intentLevel   String?
  intentTags    String?
  status        String    @default("new")
  followupAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([intentScore])
  @@index([userId, source])
  @@index([userId, status])
}

model AcquisitionLead {
  id              String           @id
  userId          String
  name            String?
  phone           String
  source          String?
  status          String           @default("new")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  aiFollowup      String?
  aiInsights      String?
  aiQuality       String?
  aiScore         Int?
  convertedAt     DateTime?
  email           String?
  lastContact     DateTime?
  notes           String?
  taskId          String?
  AcquisitionTask AcquisitionTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  LeadFollowup    LeadFollowup[]

  @@index([aiScore])
  @@index([source])
  @@index([taskId], map: "AcquisitionLead_taskId_fkey")
  @@index([userId, status])
}

model AcquisitionSource {
  id        String   @id
  userId    String
  name      String
  type      String
  config    Json?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model AcquisitionTask {
  id              String            @id
  userId          String
  title           String
  channel         String
  status          String            @default("pending")
  progress        Int               @default(0)
  leadsCount      Int               @default(0)
  targetCount     Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  AcquisitionLead AcquisitionLead[]
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "AcquisitionTask_userId_fkey")
}

model AdminLog {
  id        String   @id
  userId    String
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
  target    String?
  userAgent String?
  userName  String?
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "AdminLog_userId_fkey")
}

model Agent {
  id                String              @id
  userId            String              @unique
  level             String              @default("district")
  status            String              @default("active")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  agentType         String              @default("commission")
  balance           Decimal             @default(0.00) @db.Decimal(10, 2)
  commissionRate    Decimal             @default(0.30) @db.Decimal(10, 2)
  lastPaidAt        DateTime?
  monthlyPaid       Decimal             @default(0.00) @db.Decimal(10, 2)
  name              String
  oneTimeFee        Decimal             @default(0.00) @db.Decimal(10, 2)
  parentId          String?
  region            String?
  totalPaid         Decimal             @default(0.00) @db.Decimal(10, 2)
  totalRevenue      Decimal             @default(0.00) @db.Decimal(10, 2)
  Agent             Agent?              @relation("AgentToAgent", fields: [parentId], references: [id])
  other_Agent       Agent[]             @relation("AgentToAgent")
  User              User                @relation(fields: [userId], references: [id])
  Payment           Payment[]
  UserAgentRelation UserAgentRelation[]

  @@index([parentId], map: "Agent_parentId_fkey")
}

model AgentApiConfig {
  id         String   @id
  agentId    String   @unique
  providerId String
  apiKey     String?  @db.Text
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([agentId])
}

model AgentFeedback {
  id             String   @id
  agentId        String
  conversationId String?
  messageIndex   Int?
  userMessage    String?
  agentResponse  String?
  helpful        Boolean?
  rating         Int?
  userId         String?
  createdAt      DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([helpful, createdAt])
}

model AgentStats {
  id              String   @id
  agentId         String
  activeCustomers Int      @default(0)
  totalRevenue    Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt       DateTime
  commission      Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  newCustomers    Int      @default(0)
  period          String
  periodEnd       DateTime
  periodStart     DateTime

  @@unique([agentId, period, periodStart])
}

model Announcement {
  id          String    @id
  title       String
  content     String?   @db.Text
  type        String    @default("info")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  agentId     String?
  priority    String    @default("normal") @db.VarChar(20)
  publishedAt DateTime?
  startTime   DateTime? @db.DateTime(0)
  endTime     DateTime? @db.DateTime(0)
  status      String    @default("draft")
  target      String    @default("all")

  @@index([status, publishedAt])
}

model ApiKey {
  id          String    @id
  userId      String
  provider    String
  apiKey      String?   @db.Text
  secretKey   String?   @db.Text
  status      String    @default("active")
  isPrimary   Boolean   @default(false)
  isSecondary Boolean   @default(false)
  usage       Int       @default(0)
  limit       Int       @default(0)
  failCount   Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([userId])
  @@index([userId, provider])
}

model ApiProvider {
  id        String   @id
  name      String   @unique
  type      String   @default("coze")
  apiKey    String
  baseUrl   String
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  config    Json?
  isDefault Boolean  @default(false)
  remark    String?
}

model ApiUsageLog {
  id             String   @id
  userId         String
  agentId        String?
  providerId     String
  providerName   String
  endpoint       String
  model          String?
  requestTokens  Int?
  responseTokens Int?
  cost           Decimal? @default(0.0000) @db.Decimal(10, 4)
  duration       Int?
  status         String   @default("success")
  errorMsg       String?
  createdAt      DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([userId, createdAt])
}

model AppVersion {
  id          String    @id
  version     String
  platform    String    @default("android")
  buildNumber Int       @default(1)
  changelog   String?
  downloadUrl String?
  forceUpdate Boolean   @default(false)
  status      String    @default("released")
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([platform, status])
}

model AutomationTask {
  id           String    @id
  userId       String
  agentId      String?
  name         String
  type         String
  platform     String
  accountId    String
  config       Json
  schedule     Json?
  enabled      Boolean   @default(true)
  status       String    @default("idle")
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  runCount     Int       @default(0)
  successCount Int       @default(0)
  failCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([status, enabled])
  @@index([userId, type])
}

model BrandingConfig {
  id             String   @id
  userId         String   @unique
  appName        String   @default("智枢AI")
  logo           String?
  favicon        String?
  themeColor     String   @default("#1890ff")
  primaryColor   String   @default("#1890ff")
  secondaryColor String   @default("#52c41a")
  welcomeText    String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Candidate {
  id              String          @id
  postId          String
  userId          String
  name            String
  phone           String
  resume          String?
  status          String          @default("pending")
  remark          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  education       String?
  experience      String?
  email           String?
  lastContactedAt DateTime?
  location        String?
  matchScore      Int?            @default(0)
  skills          String?
  source          String?         @default("manual")
  RecruitmentPost RecruitmentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId], map: "Candidate_postId_fkey")
  @@index([userId], map: "Candidate_userId_fkey")
}

model CandidateSearchConfig {
  id              String    @id
  userId          String
  postId          String
  platform        String    @default("boss")
  keywords        String?
  location        String?
  experienceMin   Int?
  experienceMax   Int?
  education       String?
  salaryMin       Int?
  salaryMax       Int?
  skills          String?
  autoContact     Boolean   @default(false)
  contactTemplate String?
  status          String    @default("active")
  lastSearchedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([platform, status])
  @@index([postId], map: "CandidateSearchConfig_postId_fkey")
  @@index([userId, postId])
}

model ChatConversation {
  id           String        @id
  userId       String
  title        String        @default("新对话")
  modelKey     String?
  provider     String?
  messageCount Int           @default(0)
  lastMessage  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  ChatMessage  ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id               String           @id
  conversationId   String
  role             String           @default("user")
  content          String
  model            String?
  provider         String?
  tokens           Int?
  latency          Int?
  metadata         Json?
  createdAt        DateTime         @default(now())
  ChatConversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CodeAssistantConversation {
  id           String   @id
  userId       String
  taskType     String   @default("generate")
  language     String   @default("javascript")
  userMode     String   @default("developer")
  title        String   @default("新对话")
  modelKey     String?
  messageCount Int      @default(0)
  lastMessage  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([userId, createdAt])
  @@index([userId, taskType])
}

model CodeAssistantMessage {
  id             String   @id
  conversationId String
  role           String   @default("user")
  content        String   @db.MediumText
  model          String?
  tokens         Int?
  latency        Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CompanyInfo {
  id          String   @id
  userId      String   @unique
  name        String   @default("上海百智集网络科技有限公司")
  logo        String?
  industry    String?
  size        String?
  address     String?
  description String?
  contact     String?
  phone       String?
  email       String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model ComplianceAuditLog {
  id             String   @id
  userId         String
  contentPreview String   @db.Text
  contentType    String   @default("text")
  platform       String?
  passed         Boolean
  score          Int
  issueCount     Int      @default(0)
  criticalCount  Int      @default(0)
  warningCount   Int      @default(0)
  issues         String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([passed, createdAt])
  @@index([platform, createdAt])
  @@index([userId, createdAt])
}

model ContentFeedback {
  id               String   @id
  contentType      String
  prompt           String
  generatedContent String
  adopted          Boolean  @default(false)
  edited           Boolean  @default(false)
  rating           Int?
  editedContent    String?
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([adopted, createdAt])
  @@index([contentType, createdAt])
  @@index([userId])
}

model Conversation {
  id        String   @id
  userId    String
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId, updatedAt], map: "idx_conv_user_updated")
}

model ConversationLog {
  id              String          @id
  userId          String
  createdAt       DateTime        @default(now())
  feedback        String?
  generatedReply  String
  originalMessage String
  receiver        String
  scenario        String
  sender          String
  style           String
  templateId      String?
  ScriptTemplate  ScriptTemplate? @relation(fields: [templateId], references: [id])
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([userId, createdAt])
}

model CrmAutomationRule {
  id        String    @id
  userId    String
  name      String
  trigger   String
  condition String
  action    String
  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  runCount  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "CrmAutomationRule_userId_fkey")
}

model CrmCustomer {
  id             String        @id
  userId         String
  name           String
  phone          String?
  wechat         String?
  company        String?
  position       String?
  source         String?
  level          String?
  status         String        @default("potential")
  remark         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  lastFollowUpAt DateTime?
  tags           String?
  email          String?
  lastContact    DateTime?
  totalValue     Decimal?      @default(0.00) @db.Decimal(10, 2)
  User           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  CrmFollowUp    CrmFollowUp[]
  CrmReminder    CrmReminder[]

  @@index([userId], map: "CrmCustomer_userId_fkey")
}

model CrmFollowUp {
  id             String      @id
  customerId     String
  type           String
  content        String
  nextPlan       String?
  nextFollowUpAt DateTime?
  createdBy      String
  createdAt      DateTime    @default(now())
  CrmCustomer    CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "CrmFollowUp_customerId_fkey")
}

model CrmReminder {
  id          String      @id
  userId      String
  customerId  String
  type        String
  title       String
  remindAt    DateTime
  isCompleted Boolean     @default(false)
  createdAt   DateTime    @default(now())
  CrmCustomer CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "CrmReminder_customerId_fkey")
  @@index([userId, remindAt])
}

model CrmTag {
  id        String   @id
  userId    String
  name      String
  color     String   @default("#1890ff")
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model DataCollectionTask {
  id             String    @id
  userId         String
  source         String
  keywords       String?
  industry       String?
  region         String?
  radius         Int?
  centerLat      Float?
  centerLng      Float?
  status         String    @default("pending")
  totalCount     Int       @default(0)
  collectedCount Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model DigitalHuman {
  id          String      @id
  userId      String
  name        String
  status      String      @default("active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  avatar      String?
  description String?
  gender      String
  style       String
  usageCount  Int         @default(0)
  voice       String
  User        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  VideoTask   VideoTask[]

  @@index([status])
  @@index([userId])
}

model Employee {
  id          String    @id
  userId      String
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  avatar      String?
  email       String?
  lastLoginAt DateTime?
  name        String
  password    String
  permissions Json?
  phone       String    @unique
  role        String    @default("staff")
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([userId])
}

model EmployeeLoginLog {
  id         String   @id
  employeeId String
  ip         String?
  userAgent  String?
  status     String   @default("success")
  errorMsg   String?
  createdAt  DateTime @default(now())
}

model FeatureSubSwitch {
  id            String        @id
  featureCode   String
  code          String
  name          String
  description   String?
  enabled       Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  FeatureSwitch FeatureSwitch @relation(fields: [featureCode], references: [code])

  @@unique([featureCode, code])
}

model FeatureSwitch {
  id               String             @id
  code             String             @unique
  name             String
  description      String?
  icon             String?
  enabled          Boolean            @default(true)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  FeatureSubSwitch FeatureSubSwitch[]
}

model HotspotCache {
  id        String   @id
  platform  String
  keyword   String
  heat      Int      @default(0)
  label     String?
  category  String?
  url       String?
  rawData   String?
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([platform, keyword, cachedAt])
  @@index([heat])
  @@index([platform, cachedAt])
}

model Interview {
  id          String   @id
  userId      String
  candidateId String
  postId      String
  round       Int      @default(1)
  type        String   @default("video")
  scheduledAt DateTime
  duration    Int      @default(60)
  location    String?
  interviewer String?
  status      String   @default("scheduled")
  feedback    String?
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([candidateId])
  @@index([postId])
  @@index([scheduledAt])
  @@index([userId, status])
}

model LeadFollowup {
  id              String          @id
  leadId          String
  userId          String
  content         String
  createdAt       DateTime        @default(now())
  nextDate        DateTime?
  type            String          @default("note")
  AcquisitionLead AcquisitionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId], map: "LeadFollowup_userId_fkey")
}

model LiveRoom {
  id            String    @id
  userId        String
  platform      String    @default("douyin")
  roomId        String
  roomName      String
  hostName      String?
  link          String?
  coverUrl      String?
  status        String    @default("offline")
  viewerCount   Int       @default(0)
  likeCount     Int       @default(0)
  giftCount     Int       @default(0)
  followerCount Int       @default(0)
  salesAmount   Decimal   @default(0.00) @db.Decimal(10, 2)
  productCount  Int       @default(0)
  startTime     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([status])
  @@index([userId, platform])
}

model LoginLog {
  id         String   @id
  userId     String
  ip         String?
  device     String?
  deviceId   String?
  deviceName String?
  location   String?
  loginAt    DateTime @default(now())
  status     String   @default("success")
  token      String?  @db.Text
  isActive   Boolean  @default(true)

  @@index([userId])
}

model MapFavorite {
  id        String   @id
  userId    String
  poiId     String?
  name      String
  address   String?
  location  Json?
  type      String?
  createdAt DateTime @default(now())

  @@index([poiId])
  @@index([userId])
}

model Material {
  id             String          @id
  userId         String
  type           String
  content        String?
  title          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  fileType       String?
  fileUrl        String?
  status         String          @default("unused")
  thumbnail      String?
  usedCount      Int             @default(0)
  publishedAt    DateTime?
  contentHash    String?
  fileHash       String?
  simHash        String?
  usagePlatforms String?
  isDuplicate    Boolean         @default(false)
  User           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  PublishRecord  PublishRecord[]

  @@index([userId, type])
}

model MatrixAccount {
  id               String             @id
  userId           String
  platform         String
  accountId        String
  accountName      String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  autoPublish      Boolean            @default(false)
  avatar           String?
  User             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  PublishedContent PublishedContent[]

  @@index([userId], map: "MatrixAccount_userId_fkey")
}

model Message {
  id             String   @id
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt], map: "idx_msg_conv_created")
}

model Notification {
  id        String   @id
  userId    String
  title     String
  content   String
  type      String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  data      String?
