{
  "name": "zhishuai",
  "version": "1.0.0",
  "description": "智枢AI SaaS多租户超级应用 - 包含桌面安装版(desktop-ui)、APK端和后端服务",
  "private": true,
  "scripts": {
    "install:all": "npm run install:desktop-ui && npm run install:desktop && npm run install:apk && npm run install:server",
    "install:desktop-ui": "cd desktop-ui && npm install",
    "install:desktop": "cd desktop && npm install",
    "install:apk": "cd apk && npm install",
    "install:server": "cd server && npm install",
    "dev:desktop-ui": "cd desktop-ui && npm run dev",
    "dev:desktop": "cd desktop && npm run dev",
    "dev:apk": "cd apk && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build:desktop-ui": "cd desktop-ui && npm run build",
    "build:desktop": "cd desktop && npm run build:nsis",
    "build:apk": "cd apk && npm run build",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build:desktop-ui && npm run build:desktop && npm run build:apk && npm run build:server",
    "start:desktop-ui": "cd desktop-ui && npm start",
    "start:desktop": "cd desktop && npm start",
    "start:apk": "cd apk && npm start",
    "start:server": "cd server && npm start"
  },
  "keywords": [
    "AI",
    "SaaS",
    "自媒体",
    "电商",
    "HR",
    "营销",
    "Desktop",
    "APK",
    "Tauri"
  ],
  "author": "智枢AI",
  "license": "All rights reserved"
}
