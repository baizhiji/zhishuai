{
  "name": "zhishuai-desktop",
  "version": "3.2.9",
  "private": true,
  "description": "智枢AI SaaS — 桌面安装版（Tauri 2.x）",
  "type": "module",
  "scripts": {
    "build:desktop-ui": "cd ../desktop-ui && npm run build",
    "copy:desktop-ui": "node scripts/copy-desktop-ui-build.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:nsis": "tauri build --bundles nsis",
    "build:msi": "tauri build --bundles msi",
    "release": "node scripts/release.mjs",
    "preview:desktop-ui": "npm run build:desktop-ui && npm run copy:desktop-ui"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
