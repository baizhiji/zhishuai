{
  "name": "zhishuai-desktop",
  "version": "3.0.0",
  "private": true,
  "description": "智枢AI SaaS — 桌面安装版（Tauri 2.x）",
  "type": "module",
  "scripts": {
    "build:web": "cd ../web && npm run build",
    "copy:web": "node scripts/copy-web-build.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:nsis": "tauri build --bundles nsis",
    "build:msi": "tauri build --bundles msi",
    "release": "node scripts/release.mjs",
    "preview:web": "npm run build:web && npm run copy:web"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
