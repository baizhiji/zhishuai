# 智枢AI 桌面版环境变量模板（Tauri 构建时使用）

# 后端 API 域名根（WebView 内所有请求使用；Rust AI 代理也用它定位服务端）
NEXT_PUBLIC_API_BASE_URL=https://api.zhishuai.example

# ── Rust 主进程 AI 代理凭据（优先于用户配置，可选）──
# 若留空，AI 代理将从系统凭据管理器（keyring）读取用户已保存的密钥
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=qwen-plus

# ── 自动更新签名（tauri-plugin-updater 必需，仅 CI 构建时使用）──
# 生成方式: npx tauri signer generate -w ~/.tauri/zhishuai.key
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# 更新服务器端点（指向后端 /api/version/desktop/latest.json）
TAURI_UPDATER_ENDPOINTS=https://api.zhishuai.example/api/version/desktop/latest.json

# ── 窗口与发布元数据 ──
APP_VERSION=3.0.0
APP_PUBLISHER=智枢AI
